# YouTube Data API v3 key — get one at https://console.cloud.google.com
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube channel ID or URL
YOUTUBE_CHANNEL_ID=UC_CHANNEL_ID_HERE

# Anthropic API key for Claude analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Instagram account handle (without @)
INSTAGRAM_HANDLE=thedivyajainpodcast

# Optional: path to Instagram data export JSON
INSTAGRAM_EXPORT_PATH=

# Optional: path to keyword volume CSV from SEO tool (Ahrefs, Ubersuggest, etc.)
KEYWORD_VOLUME_CSV_PATH=
